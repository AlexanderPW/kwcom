# --- Contact form SMTP (HostGator) ---
# Copy this file to `.env.local` and fill in the real values.
# In production, set these in the Vercel dashboard:
#   Project → Settings → Environment Variables.

# HostGator (cPanel) mail server. Use `mail.<domain>` for the mailbox's domain.
# If mail.<domain> doesn't resolve/connect, use the server hostname shown in
# cPanel → "Email Accounts" → "Connect Devices" (e.g. gatorXXXX.hostgator.com).
#   SSL:      SMTP_PORT=465
#   STARTTLS: SMTP_PORT=587
SMTP_HOST=mail.potentialonpoint.com
SMTP_PORT=465

# Full email address as the username, plus its mailbox password.
SMTP_USER=kelseywaldrop@potentialonpoint.com
SMTP_PASS=your-mailbox-password

# Where submissions are delivered (defaults to SMTP_USER if omitted).
CONTACT_TO=kelseywaldrop@potentialonpoint.com

# The "From" address. Must be a mailbox on your domain (keeps SPF/DKIM valid).
# Defaults to SMTP_USER if omitted.
CONTACT_FROM=kelseywaldrop@potentialonpoint.com
